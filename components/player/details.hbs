{{! ─── TOP NAV ─────────────────────────────────────── }}
<div
  class="sticky top-0 z-10 bg-white/98 dark:bg-slate-900/98 backdrop-blur-md border-b border-gray-100 dark:border-slate-800 px-4 sm:px-10">
  <div class="flex items-end gap-1 overflow-x-auto scrollbar-none">
    <button type="button"
      class="relative px-4 py-2.5 text-sm font-semibold transition-colors duration-150
        {{if this.isGeneral 'text-red-500' 'text-gray-400 dark:text-slate-500 hover:text-gray-700 dark:hover:text-slate-300'}}"
      {{on "click" (fn this.switchMainTab "general")}}>
      General
      <span
        class="absolute bottom-0 left-0 right-0 h-[2.5px] rounded-t-full transition-all duration-200
          {{if this.isGeneral 'bg-red-500 opacity-100' 'opacity-0'}}">
      </span>
    </button>
    <button type="button"
      class="relative px-4 py-2.5 text-sm font-semibold transition-colors duration-150
        {{if this.isCricket 'text-red-500' 'text-gray-400 dark:text-slate-500 hover:text-gray-700 dark:hover:text-slate-300'}}"
      {{on "click" (fn this.switchMainTab "cricket")}}>
      Cricket
      <span
        class="absolute bottom-0 left-0 right-0 h-[2.5px] rounded-t-full transition-all duration-200
          {{if this.isCricket 'bg-red-500 opacity-100' 'opacity-0'}}">
      </span>
    </button>
  </div>
</div>


{{! ══════════════════════════════════════════════════════ }}
{{! PAGE 1 — GENERAL                                       }}
{{! ══════════════════════════════════════════════════════ }}
{{#if this.isGeneral}}
<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-5">

  {{! ─── HERO CARD ─── }}
  <div
    class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 overflow-hidden">
    <div class="h-28 sm:h-36 bg-gradient-to-br from-red-600 via-rose-500 to-orange-400"></div>
    <div class="px-5 pb-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 sm:gap-3 -mt-14 sm:-mt-16">
        <div class="flex items-start sm:items-end gap-3 sm:gap-4 min-w-0">
          <img
            src={{if this.player.user_primary_pic (concat this.api.bucket_Images_Host "/" this.player.user_primary_pic) this.defaultAvatar}}
            alt={{this.fullName}}
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover border-4 border-white dark:border-slate-900 shadow-lg flex-shrink-0 bg-gray-100 dark:bg-slate-800" />
          <div class="pb-1 min-w-0">
            <h1 class="text-lg sm:text-2xl font-bold text-gray-900 dark:text-slate-100 leading-tight truncate">
              {{this.fullName}}
            </h1>
            <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5 truncate">@{{this.player.user_username}}</p>
            {{#if this.player.user_country}}
            <div class="flex items-center gap-1.5 mt-2 flex-wrap">
              <span class="text-base leading-none">{{this.countryFlag}}</span>
              <span class="text-xs font-semibold text-gray-600 dark:text-slate-300">{{this.player.user_country}}</span>
              {{#if this.player.user_playing_city}}
              <span class="text-gray-300 dark:text-slate-600">·</span>
              <span class="text-xs text-gray-500 dark:text-slate-400">{{this.player.user_playing_city}}</span>
              {{/if}}
            </div>
            {{/if}}
          </div>
        </div>
        <div class="flex items-center gap-2 pb-1 flex-wrap justify-end">
          <button type="button"
            class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-400 hover:border-red-400 hover:text-red-500 transition whitespace-nowrap"
            {{on "click" (fn this.copyProfileLink this.player.user_username)}}>
            {{lucide-icon "copy" size=12}}
            Copy Link
          </button>
        </div>
      </div>
      {{#if this.player.user_interested_sports.all_sports.length}}
      <div class="mt-4 flex flex-wrap gap-1.5">
        {{#each this.sportsWithIcons as |s|}}
        <span
          class="inline-flex items-center gap-1.5 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-semibold px-3 py-1 rounded-full border border-green-200 dark:border-green-700">
          {{#if s.icon}}
          <img src={{s.icon}} alt="" class="w-4 h-4 object-contain" aria-hidden="true" />
          {{/if}}
          {{s.name}}
        </span>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </div>

  {{! ─── KEY STATS STRIP ─── }}
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-4 text-center shadow-sm">
      <p class="text-[10px] text-gray-400 dark:text-slate-500 font-bold uppercase tracking-widest mb-1">Age</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-slate-100">{{this.playerAge}}</p>
    </div>
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-4 text-center shadow-sm">
      <p class="text-[10px] text-gray-400 dark:text-slate-500 font-bold uppercase tracking-widest mb-1">Gender</p>
      <p class="text-xl font-bold text-gray-900 dark:text-slate-100 capitalize">
        {{if this.player.user_sex this.player.user_sex "N/A"}}
      </p>
    </div>
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-4 text-center shadow-sm">
      <p class="text-[10px] text-gray-400 dark:text-slate-500 font-bold uppercase tracking-widest mb-1">Height</p>
      <p class="text-xl font-bold text-gray-900 dark:text-slate-100">{{this.playerHeight}}</p>
    </div>
    <div
      class="bg-white dark:bg-slate-900 rounded-2xl border border-gray-200 dark:border-slate-700 p-4 text-center shadow-sm">
      <p class="text-[10px] text-gray-400 dark:text-slate-500 font-bold uppercase tracking-widest mb-1">Weight</p>
      <p class="text-xl font-bold text-gray-900 dark:text-slate-100">{{this.playerWeight}}</p>
    </div>
  </div>

  {{! ─── PERSONAL INFORMATION ─── }}
  <div
    class="bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
    <h2 class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-widest mb-3">Personal
      Information</h2>
    <div class="divide-y divide-gray-100 dark:divide-slate-800">
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Full
          Name</span>
        <span class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1 break-words">{{this.fullName}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Username</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1 truncate">@{{this.player.user_username}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Born</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1">{{if this.player.user_dob this.player.user_dob "N/A"}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Gender</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1 capitalize">{{if this.player.user_sex this.player.user_sex "N/A"}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Nationality</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1">{{if this.player.user_country this.player.user_country "N/A"}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">State /
          Division</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1 break-words">{{if this.player.user_state_divition this.player.user_state_divition "N/A"}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Playing
          City</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1 break-words">{{if this.player.user_playing_city this.player.user_playing_city "N/A"}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Body
          Type</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1">{{if this.player.user_configuration.body_type this.player.user_configuration.body_type "N/A"}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Height</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1">{{this.playerHeight}}</span>
      </div>
      <div class="flex items-center gap-2 py-3">
        <span
          class="text-xs font-semibold text-gray-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 w-24 sm:w-36">Weight</span>
        <span
          class="text-sm font-semibold text-gray-900 dark:text-slate-100 text-right min-w-0 flex-1">{{this.playerWeight}}</span>
      </div>
    </div>
  </div>

  {{! ─── BIO ─── }}
  {{#if this.hasAbout}}
  <div
    class="bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
    <h2 class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-widest mb-4">About</h2>

    {{#if this.aboutInfo.bio}}
    <p class="text-sm text-gray-700 dark:text-slate-300 leading-relaxed mb-5">{{this.aboutInfo.bio}}</p>
    {{/if}}

    {{#if this.aboutInfo.school}}
    <div class="mb-4">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
          </svg>
        </div>
        <span class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Education</span>
      </div>
      <div class="ml-9 bg-gray-50 dark:bg-slate-800 rounded-xl p-3.5">
        <p class="text-sm font-semibold text-gray-900 dark:text-slate-100">{{this.aboutInfo.school}}</p>
        {{#if this.aboutInfo.schoolStart}}
        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">Since {{this.aboutInfo.schoolStart}}</p>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{#if this.aboutInfo.jobs.length}}
    <div>
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
          </svg>
        </div>
        <span class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Work</span>
      </div>
      <div class="ml-9 space-y-2">
        {{#each this.aboutInfo.jobs as |job|}}
        <div class="bg-gray-50 dark:bg-slate-800 rounded-xl p-3.5">
          {{#if job.title}}
          <p class="text-sm font-semibold text-gray-900 dark:text-slate-100">{{job.title}}</p>
          {{/if}}
          {{#if job.company}}
          <p class="text-xs text-gray-600 dark:text-slate-300 mt-0.5">{{job.company}}</p>
          {{/if}}
          {{#if job.startAt}}
          <p class="text-xs text-gray-400 dark:text-slate-500 mt-1">
            {{job.startAt}}{{#if job.endAt}} – {{job.endAt}}{{else}} – Present{{/if}}
          </p>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

  </div>
  {{/if}}

  {{! ─── PLAYING SPORTS ─── }}
  {{#if this.player.user_playing_sports.length}}
  <div
    class="bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
    <h2 class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-widest mb-3">Playing Sports</h2>
    <div class="flex flex-wrap gap-2">
      {{#each this.player.user_playing_sports as |sport|}}
      <span
        class="bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-200 dark:border-blue-700 capitalize">
        {{sport}}
      </span>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{! ─── GALLERY ─── }}
  {{#if this.player.galleryImages.length}}
  <div
    class="bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
    <h2 class="text-xs font-bold text-gray-400 dark:text-slate-500 uppercase tracking-widest mb-4">Gallery</h2>
    <div class="flex flex-wrap gap-2">
      {{#each this.player.galleryImages as |img|}}
      <div
        class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border border-gray-200 dark:border-slate-700 bg-gray-100 dark:bg-slate-800">
        {{#if img}}
        <img src={{img}} alt="gallery" class="w-full h-full object-cover" />
        {{else}}
        <div class="w-full h-full flex items-center justify-center">
          {{lucide-icon "image" size=20 class="text-gray-300 dark:text-slate-600"}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

</div>
{{/if}}


{{! ══════════════════════════════════════════════════════ }}
{{! PAGE 2 — CRICKET                                       }}
{{! ══════════════════════════════════════════════════════ }}
{{#if this.isCricket}}
<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 space-y-5">

  {{! Cricket profile hero }}
  <div
    class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 overflow-hidden">
    <div class="h-20 sm:h-24 bg-gradient-to-r from-emerald-600 via-green-500 to-teal-500"></div>
    <div class="px-5 pb-5">
      <div class="flex flex-col sm:flex-row sm:items-end gap-3 sm:gap-4 -mt-10 sm:-mt-12">
        <img
          src={{if this.cricketPrimaryPic this.cricketPrimaryPic this.defaultCricketAvatar}}
          alt={{this.player.user_username}}
          class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover border-4 border-white dark:border-slate-900 shadow-lg bg-gray-100 dark:bg-slate-800"
          {{on "error" this.onCricketImgError}} />
        <div class="pb-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-base sm:text-lg font-bold text-gray-900 dark:text-slate-100 truncate">
              {{this.player.user_username}}
            </h2>
            <span
              class="bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs font-bold px-2.5 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-700">
              Cricket
            </span>
          </div>
          {{#if this.cricket.player_nickname}}
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5 italic">"{{this.cricket.player_nickname}}"</p>
          {{/if}}
        </div>
      </div>

      <div class="mt-4 grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {{#if this.cricket.skills}}
        <div class="flex flex-col gap-0.5 p-3 rounded-xl bg-gray-50 dark:bg-slate-800 min-w-0">
          <span class="text-[10px] font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Skills</span>
          <span class="text-sm font-semibold text-gray-900 dark:text-slate-100 truncate">{{get this.cricket.skills
            "0"}}</span>
        </div>
        {{/if}}
        {{#if this.cricket.match_fee}}
        <div class="flex flex-col gap-0.5 p-3 rounded-xl bg-gray-50 dark:bg-slate-800 min-w-0">
          <span class="text-[10px] font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Match
            Fee</span>
          <span class="text-sm font-semibold text-gray-900 dark:text-slate-100">{{this.cricket.match_fee}}</span>
        </div>
        {{/if}}
        {{#if this.cricket.tournament_fee}}
        <div class="flex flex-col gap-0.5 p-3 rounded-xl bg-gray-50 dark:bg-slate-800 min-w-0">
          <span class="text-[10px] font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Tournament
            Fee</span>
          <span class="text-sm font-semibold text-gray-900 dark:text-slate-100">{{this.cricket.tournament_fee}}</span>
        </div>
        {{/if}}
        {{#if this.cricket.career_highlights.length}}
        <div class="flex flex-col gap-1 p-3 rounded-xl bg-gray-50 dark:bg-slate-800 col-span-2 sm:col-span-1">
          <span
            class="text-[10px] font-bold text-gray-400 dark:text-slate-500 uppercase tracking-wider">Highlights</span>
          <div class="flex flex-wrap gap-1">
            {{#each this.cricket.career_highlights as |h|}}
            <span
              class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-semibold px-2 py-0.5 rounded-full">{{h}}</span>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{! Stats section }}
  <div
    class="bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-gray-200 dark:border-slate-700 overflow-hidden">

    {{! Inner pill tabs }}
    <div
      class="flex overflow-x-auto scrollbar-none border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-800/50 px-4 gap-1 py-2">
      <button type="button"
        class="px-4 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all
          {{if this.isBatting 'bg-blue-600 text-white shadow-sm' 'text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700'}}"
        {{on "click" (fn this.switchStatsTab "batting")}}>Batting</button>
      <button type="button"
        class="px-4 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all
          {{if this.isBowling 'bg-blue-600 text-white shadow-sm' 'text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700'}}"
        {{on "click" (fn this.switchStatsTab "bowling")}}>Bowling</button>
      <button type="button"
        class="px-4 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all
          {{if this.isFielding 'bg-blue-600 text-white shadow-sm' 'text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700'}}"
        {{on "click" (fn this.switchStatsTab "fielding")}}>Fielding</button>
      <button type="button"
        class="px-4 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all
          {{if this.isOverall 'bg-blue-600 text-white shadow-sm' 'text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700'}}"
        {{on "click" (fn this.switchStatsTab "overall")}}>Overall</button>
      {{!-- <button type="button"
        class="px-4 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all
          {{if this.isGallery 'bg-blue-600 text-white shadow-sm' 'text-gray-500 dark:text-slate-400 hover:bg-gray-200 dark:hover:bg-slate-700'}}"
        {{on "click" (fn this.switchStatsTab "gallery")}}>Gallery</button> --}}
    </div>

    <div class="p-3 sm:p-4 lg:p-6">

      {{! ── BATTING ── }}
      {{#if this.isBatting}}
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">

        <div class="rounded-2xl border border-blue-100 dark:border-blue-900/40 overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 bg-blue-600">
            {{lucide-icon "bar-chart-2" size=14 class="text-white"}}
            <span class="text-xs font-bold text-white uppercase tracking-widest">Overall</span>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-slate-700/50">
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">Games Batted</span>

              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">Bowling Strike Rate</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.bowlingStrikeRate}}</span>
            </div>
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">Run Out</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.runOut}}</span>
            </div>
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">Catch Out</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.catchOut}}</span>
            </div>
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">Man of the Match</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.manOfTheMatch}}</span>
            </div>
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">City Ranking</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.cityRanking}}</span>
            </div>
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">World Ranking</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.worldRanking}}</span>
            </div>
            <div class="flex justify-between items-center gap-2 px-4 py-2.5 even:bg-gray-50/60 dark:even:bg-slate-800/30">
              <span class="text-xs text-gray-500 dark:text-slate-400 flex-shrink-0">Country Ranking</span>
              <span class="text-sm font-bold text-gray-900 dark:text-slate-100 text-right tabular-nums">{{this.overall_history.tournament.countryRanking}}</span>
            </div>
          </div>
        </div>

      </div>
      {{/if}}

      {{!-- ── GALLERY ── }}
      {{#if this.isGallery}}
      {{#if this.gallery_images.length}}
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-3">
        {{#each this.gallery_images as |imgUrl|}}
        <div class="rounded-xl overflow-hidden border border-gray-200 dark:border-slate-700 aspect-square">
          <img src="{{imgUrl}}" alt="gallery"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="flex flex-col items-center justify-center py-16">
        {{lucide-icon "image" size=48 class="text-gray-200 dark:text-slate-700 mb-3"}}
        <span class="text-sm text-gray-400 dark:text-slate-500">No gallery images yet.</span>
      </div>
      {{/if}}
      {{/if}} --}}

    </div>
  </div>

</div>
{{/if}}
